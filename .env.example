# Xgent Hub 服务端配置
# 复制为 .env 后按需修改

# 管理员登录令牌（必填，登录页面输入此令牌换取会话 Cookie）
ADMIN_TOKEN=change-me-please

# 监听地址与端口（默认只监听本机，不要改成 0.0.0.0 直接暴露公网）
HOST=127.0.0.1
PORT=4180

# SQLite 数据文件路径（相对 server 目录）
DB_PATH=./data/agenthub.sqlite

# 日志级别：默认 warn（只打告警/错误），设成 info 能看到每次 API 请求的详细日志
LOG_LEVEL=warn

# 开发/测试用：设为 1 时 Agent 列表里会出现 Mock Agent（不调用任何模型，用来测任务、审批、Diff 流程）
# AGENTHUB_ENABLE_MOCK=1

# npm run version:backup 的版本备份目录（比如共享盘 \\NAS\share\XgentHub）；不填时需要用 -BackupRoot 指定
# VERSION_BACKUP_ROOT=

# AI 智能拆分时一个任务里最多同时跑几个子任务；不填或 0 = 不限制
# AGENTHUB_MAX_PARALLEL_SUBTASKS=3

# ---- OpenClaw adapter ----
# openclaw CLI 可执行文件名/路径（默认使用 PATH 中的 openclaw）
OPENCLAW_BIN=openclaw
# 目标 agent id（对应 openclaw agents 中配置的 agent，留空使用默认路由）
OPENCLAW_AGENT_ID=
# 单次调用超时（秒）
OPENCLAW_TIMEOUT=600
# 无输出保护超时（秒）。本地 30B/31B 模型首次加载可能较慢，默认给 10 分钟。
OPENCLAW_IDLE_TIMEOUT=600

# ---- Codex adapter（基于 `codex exec --json` 非交互模式）----
# codex CLI 可执行文件名/路径（npm i -g @openai/codex 安装，需要先 `codex login`）
CODEX_BIN=codex
# 沙箱模式：read-only | workspace-write | danger-full-access（见 `codex exec --help`）
CODEX_SANDBOX_MODE=workspace-write
# 单次调用超时（秒）
CODEX_TIMEOUT=900

# ---- Claude Code adapter（可用本机 claude CLI headless 模式）----
# 如果 claude 不在 PATH 里（比如只装了 Claude 桌面版，没装独立 CLI），
# 把这里改成桌面版自带的实际路径，类似：
# C:\Users\<you>\AppData\Local\Packages\Claude_<id>\LocalCache\Roaming\Claude\claude-code\<version>\claude.exe
CLAUDE_CODE_BIN=claude
CLAUDE_CODE_ARGS=--print --output-format stream-json --verbose

# ---- Antigravity adapter（基于 `agy -p --output-format stream-json` headless 模式）----
# 安装 Antigravity CLI 后默认使用 PATH 中的 agy；如果不在 PATH，填完整 agy.exe 路径
ANTIGRAVITY_BIN=agy
# 新建任务时没在下拉框选模型的话，兜底用这个；留空用 Antigravity CLI 默认模型
ANTIGRAVITY_MODEL=
# low | medium | high；留空使用 CLI 默认
ANTIGRAVITY_EFFORT=
# 传给 agy --print-timeout，例如 100m、6000s
ANTIGRAVITY_PRINT_TIMEOUT=100m
# Xgent Hub 等待 agy 进程的硬超时（秒）
ANTIGRAVITY_TIMEOUT=6000

# ---- Ark CLI adapter（火山方舟 arkcli +chat headless 模式）----
# 安装：npm install -g @volcengine/ark-cli@latest，然后 arkcli auth login
ARK_CLI_BIN=arkcli
# 留空使用 arkcli 当前默认 profile
ARK_CLI_PROFILE=
# 可留空，留空时使用 arkcli auth login / config init 保存的本机登录态
ARK_CLI_API_KEY=
# 留空使用 arkcli 默认；常见值：https://ark.cn-beijing.volces.com/api/v3
ARK_CLI_BASE_URL=
# 新建任务时没在下拉框选模型的话，兜底用这个；platform profile 通常填 ep-*，plan profile 可填模型名
ARK_CLI_MODEL=
# minimal | low | medium | high；留空使用模型默认
ARK_CLI_REASONING_EFFORT=
ARK_CLI_TIMEOUT=900

# ---- Hermes adapter（OpenAI 兼容本机服务）----
HERMES_BASE_URL=http://127.0.0.1:8000
HERMES_API_KEY=
HERMES_MODEL=hermes

# ---- 推荐 API 中转站（TokenEZGO，OpenAI 兼容）----
# 到 https://tokenezgo.com 充值后获取 API Key，再填 TOKENEZGO_API_KEY。
TOKENEZGO_BASE_URL=https://tokenezgo.com/v1
TOKENEZGO_API_KEY=
# 新建任务时没在下拉框选模型的话，兜底用这个（留空则必须在新建任务时选）
TOKENEZGO_MODEL=

# ---- Doubao / 火山方舟 adapter（OpenAI 兼容 API）----
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_API_KEY=
# 新建任务时没在下拉框选模型的话，兜底用这个；可填火山方舟模型或推理接入点 ID
DOUBAO_MODEL=

# ---- Ollama adapter（直连本机 ollama serve，原生 API 不是 OpenAI 兼容层）----
OLLAMA_BASE_URL=http://127.0.0.1:11434
# 新建任务时没在下拉框选模型的话，兜底用这个（留空则必须在新建任务时选）
OLLAMA_MODEL=
# Ollama 显存保活时间：0=请求结束立即释放；30s=保留 30 秒；留空则使用 Ollama 默认值（通常 5m）
OLLAMA_KEEP_ALIVE=

# 另外添加的 Codex / Claude Code 账号放在哪（每个账号一个子目录，里面是它自己的登录和设置）。
# 不填就是 ~/.xgent/codex-accounts 和 ~/.xgent/claude-accounts。默认账号始终是 ~/.codex 和 ~/.claude。
# CODEX_ACCOUNTS_DIR=
# CLAUDE_ACCOUNTS_DIR=
