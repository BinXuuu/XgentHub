node_modules/
dist/
build/
web/dist/
logs/*
!logs/.gitkeep
backups/*
!backups/.gitkeep
*.log
.env
# 保存配置时留的上一版（含 ADMIN_TOKEN）和写入中的临时文件
.env.bak
.env.*.tmp
.env.corrupt-*
*.tsbuildinfo
.DS_Store

# 运行时数据：数据库、附件、快照仓库，以及可能含 API Key / MCP 令牌的配置文件，都不进版本库
server/data/*
!server/data/.gitkeep
*.sqlite
*.sqlite-*
.codex-runtime/

# 开源版导出副本（单独的 git 仓库，推到 GitHub 用，见 scripts/export-opensource.mjs）
/XgentHub-opensource/

# docker compose 的数据和工作区挂载目录
/xgent-data/
/workspaces/
